                faq_a6: "Les fournisseurs accordent généralement une période de grâce de 30 à 60 minutes. Au-delà, une journée supplémentaire peut être facturée. Si vous savez que vous serez en retard, contactez le comptoir de location directement ou appelez notre assistance 24h/24 dès que possible.",
                whatsapp_cta: 'Contact Us'
            },
            de: {
                hero_headline:   'Mietwagen für den Urlaub',
                check_1: 'Kostenlose Stornierung',
                check_2: 'Keine versteckten Gebühren',
                check_3: '800+ Anbieter weltweit',
                check_4: '24/7 Kundendienst',
                locations_heading: 'Beliebte Mietstandorte',
                price_template: 'ab {0} pro Tag',
                faq_heading: 'Häufig gestellte Fragen',
