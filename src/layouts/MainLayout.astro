---
interface Props {
    title?: string;
}
const { title = 'Worldwide Car Rental Booking | Auto Reservation Plus' } = Astro.props;
const comURL = 'https://auto-reservation-plus.com' + Astro.url.pathname;
const coukURL = 'https://auto-reservation-plus.co.uk' + Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en" translate="no">
<script is:inline>
    (function() {
        var lang = localStorage.getItem('arp_lang');
        if (lang && ['en','fr','de','es','it'].indexOf(lang) !== -1) {
            document.documentElement.lang = lang;
        }
    })();
</script>
<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:inline>.site-nav ul li a.nav-pill{border-radius:50px;background:#edf5f9;box-shadow:inset 0 0 0 2px #bee1eb;}</style>
    <script is:inline>
        // Set language and currency from Netlify geo cookie on first visit.
        // Reloads when a non-English locale is detected so CT initialises with the
        // correct locale on the second load (localStorage is populated before any script runs).
        (function() {
            if (localStorage.getItem('arp_lang')) return;
            var match = document.cookie.match(/arp_country=([^;]+)/);
            var country = match ? match[1] : null;
            if (!country || country === 'XX') return;
            var langMap  = { ES:'es', FR:'fr', DE:'de', IT:'it', AT:'de', CH:'de', BE:'fr', LU:'fr' };
            var lang     = langMap[country] || 'en';
            var currency = country === 'GB' ? 'GBP' : 'EUR';
            localStorage.setItem('arp_lang', lang);
            localStorage.setItem('arp_currency', currency);
            if (lang !== 'en') location.reload();
        })();
    </script>
    <meta name="description" content="Compare global car rental options and book securely with Auto Reservation Plus. Backed by 40+ years of expertise." />
    <link rel="canonical" href={comURL} />
    <link rel="alternate" hreflang="x-default" href={comURL} />
    <link rel="alternate" hreflang="en-gb" href={coukURL} />
    <!-- Google Analytics — loaded only after cookie consent -->
    <script is:inline>
        // Google Consent Mode v2
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        // Set denied defaults before GA loads — required for Consent Mode v2
        gtag('consent', 'default', {
            analytics_storage:    'denied',
            ad_storage:           'denied',
            ad_user_data:         'denied',
            ad_personalization:   'denied',
            wait_for_update:      500
        });

        // If user has already consented, grant immediately
        if (localStorage.getItem('arp_cookie_consent') === 'accepted') {
            gtag('consent', 'update', {
                analytics_storage:  'granted',
                ad_storage:         'granted',
                ad_user_data:       'granted',
                ad_personalization: 'granted'
            });
        }

        // Load GA for all visitors — runs cookieless until consent granted
        (function() {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=G-V4F5EHGHHS';
            document.head.appendChild(s);
        })();
        gtag('js', new Date());
        gtag('config', 'G-V4F5EHGHHS', { anonymize_ip: true });
    </script>
    <style is:global>
        :root {
            --brand-blue: #2BA6CB;
            --brand-green: #99CC00;
            --brand-orange: #ff6600;
            --dark-text: #333;
            --light-bg: #f4f4f4;
        }
        * { box-sizing: border-box; }
        html { scrollbar-gutter: stable; }
        body { margin: 0 auto; max-width: 2400px; font-family: 'Helvetica Neue', Arial, sans-serif; background: var(--light-bg); line-height: 1.5; overflow-x: hidden; min-height: 100vh; display: flex; flex-direction: column; }
        main { flex: 1; }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; width: 100%; }

        header { background: white; border-bottom: 1px solid #eee; padding-block: 0.5rem; }
        .top-flex { display: flex; justify-content: space-between; align-items: center; }
        .logo-area { line-height: 0; padding: 10px 0; }
        .logo-area img { width: 300px; height: 41px; }

        .site-nav ul { display: flex; list-style: none; margin: 0; padding: 0; gap: 4px; }
        .site-nav ul li a {
            display: block;
            padding: 8px 16px;
            color: var(--brand-blue);
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            transition: color 0.2s ease;
        }
        .site-nav ul li a:hover { color: var(--brand-orange); }
        .site-nav ul li a.is-active { color: var(--brand-orange); }
        .site-nav ul li a.nav-pill {
            border-radius: 50px;
            background: #edf5f9;
            box-shadow: inset 0 0 0 2px #bee1eb;
            transition: none;
        }

        .nav-toggle {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
        }
        .nav-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            background: var(--brand-blue);
            border-radius: 2px;
            transition: transform 0.3s ease, opacity 0.3s ease;
            transform-origin: center;
        }
        .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
        .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 900;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .nav-overlay.is-open { opacity: 1; pointer-events: auto; }

        .off-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 280px;
            height: 100%;
            background: white;
            z-index: 1000;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            box-shadow: 4px 0 20px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
        }
        .off-canvas.is-open { transform: translateX(0); }
        .off-canvas-header {
            padding: 18px 20px 17px;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .off-canvas-header img { max-width: 200px; }
        .off-canvas-nav { list-style: none; margin: 0; padding: 12px 0; }
        .off-canvas-nav li a {
            display: block;
            padding: 14px 24px;
            color: var(--dark-text);
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            border-left: 3px solid transparent;
            transition: color 0.2s ease, border-color 0.2s ease;
        }
        .off-canvas-nav li a:hover { color: var(--brand-orange); border-left-color: var(--brand-orange); }

        @media (max-width: 900px) {
            .site-nav { display: none; }
            .nav-toggle { display: flex; }
        }
        @media (max-width: 600px) {
            .logo-area img { width: 260px; height: 35px; }
        }
        @media (max-width: 400px) {
            .logo-area img { width: 200px; height: 27px; }
        }

        footer { background: white; color: #999; font-size: 13px; border-top: 1px solid #eee; }
        .footer-main {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            align-items: center;
            padding: 40px 0;
            border-bottom: 1px solid #eee;
        }
        .footer-col-1 { display: flex; gap: 16px; align-items: center; justify-content: flex-start; }
        .footer-col-2 { display: flex; justify-content: center; }
        .payment-icons { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center; }
        .pay-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 28px;
            border-radius: 4px;
            border: 1px solid #e0e0e0;
            font-size: 11px;
            font-weight: 900;
            font-family: 'Helvetica Neue', Arial, sans-serif;
            letter-spacing: 0.5px;
        }
        .pay-visa  { background: #1A1F71; color: white; font-style: italic; font-size: 13px; border-color: #1A1F71; }
        .pay-amex  { background: #2E77BC; color: white; font-size: 9px; letter-spacing: 0.3px; border-color: #2E77BC; }
        .pay-paypal { background: white; color: #003087; font-size: 8.5px; letter-spacing: 0; }
        .pay-mc svg { display: block; }
        .pay-applepay { background: black; border-color: black; padding: 7px 6px; overflow: hidden; }
        .pay-applepay svg { width: 100%; height: 100%; }
        .pay-googlepay { background: white; font-size: 8px; letter-spacing: 0; gap: 1px; padding-inline: 2px; }
        .footer-col-3 { display: flex; justify-content: flex-end; }
        .footer-social-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #f5f5f5;
            color: #555;
            transition: background 0.2s, color 0.2s;
        }
        .footer-social-link:hover { background: var(--brand-blue); color: white; }
        .footer-social-link svg { flex-shrink: 0; }
        .footer-whatsapp {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #25D366;
            color: white;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            padding: 10px 20px;
            border-radius: 50px;
            transition: background 0.2s ease;
        }
        .footer-whatsapp:hover { background: #1ebe5d; }
        .footer-whatsapp svg { flex-shrink: 0; }
        .footer-bottom {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            align-items: center;
            padding: 16px 0;
            font-size: 12px;
            color: #bbb;
        }
        .footer-bottom-center { text-align: center; }
        .footer-bottom-right {
            display: flex;
            justify-content: flex-end;
            gap: 16px;
        }
        .footer-bottom-right a {
            color: #bbb;
            text-decoration: none;
            transition: color 0.2s;
        }
        .footer-bottom-right a:hover { color: var(--brand-blue); }
        @media (max-width: 600px) {
            .footer-bottom {
                grid-template-columns: 1fr;
                gap: 8px;
                text-align: center;
            }
            .footer-bottom-center { text-align: center; }
            .footer-bottom-right { justify-content: center; }
        }
        @media (max-width: 600px) {
            .footer-main {
                grid-template-columns: 1fr;
                gap: 24px;
                padding: 30px 0;
                text-align: center;
            }
            .footer-col-1 { justify-content: center; }
            .footer-col-3 { justify-content: center; }
        }
    </style>

    <script is:inline>
        window.ARP = window.ARP || {};

        window.ARP.ctLocales = {
            en: 'en_GB', fr: 'fr_FR', de: 'de_DE', es: 'es_ES', it: 'it_IT'
        };

        window.ARP.prices = {
            GBP: { paris:'£35', berlin:'£28', madrid:'£22', rome:'£30', london:'£45', lisbon:'£19' },
            EUR: { paris:'€40', berlin:'€32', madrid:'€25', rome:'€34', london:'€52', lisbon:'€22' },
            USD: { paris:'$44', berlin:'$36', madrid:'$28', rome:'$38', london:'$57', lisbon:'$24' }
        };

        window.ARP.translations = {
            en: {
                hero_headline:   'Holiday Car Rentals',
                check_1: 'Free Cancellation',
                check_2: 'No Hidden Charges',
                check_3: '800+ Suppliers Worldwide',
                check_4: '24/7 Customer Support',
                locations_heading: 'Popular Rental Locations',
                price_template: 'from {0} per day',
                faq_heading: 'Frequently Asked Questions',
                faq_q1: 'What documents do I need to hire a car?',
                faq_a1: "You'll need a valid full driving licence, a passport or national ID card, and a credit card in the main driver's name for the security deposit. Some destinations may require an International Driving Permit — we'll flag this during the booking process.",
                faq_q2: 'Is there a minimum age to rent a car?',
                faq_a2: 'The minimum age is typically 21, though this varies by supplier and country. Drivers under 25 may incur a young driver surcharge. Some premium or specialist vehicle categories require a minimum age of 25.',
                faq_q3: 'Can I cancel or modify my booking?',
                faq_a3: 'Yes — most bookings include free cancellation up to 48 hours before pick-up. Amendments can be made by contacting our support team. Terms vary by rate type, so check your booking confirmation for full details.',
                faq_q4: 'What insurance is included?',
                faq_a4: 'All rentals include Collision Damage Waiver (CDW) and Theft Protection as standard, reducing your liability in the event of an accident or theft. A refundable excess may still apply. We also offer full excess protection upgrades for complete peace of mind.',
                faq_q5: 'Can I add an additional driver?',
                faq_a5: 'Yes, additional drivers can be added at the rental desk for a small daily fee. They must be present at pick-up with their driving licence and passport. Some suppliers include one additional driver free of charge — this will be shown on your voucher if applicable.',
                faq_q6: 'What happens if I return the car late?',
                faq_a6: 'Suppliers typically allow a grace period of 30–60 minutes. Beyond that, an additional day\'s charge may be applied. If you know you\'ll be late, contact the rental desk directly or call our 24/7 support line as early as possible to avoid extra fees.',
                whatsapp_cta: 'Contact Us'
            },
            fr: {
                hero_headline:   'Location de voiture en vacances',
                check_1: 'Annulation gratuite',
                check_2: 'Sans frais cachés',
                check_3: '800+ fournisseurs dans le monde',
                check_4: 'Assistance 24h/24, 7j/7',
                locations_heading: 'Destinations populaires',
                price_template: 'à partir de {0} par jour',
                faq_heading: 'Questions fréquentes',
                faq_q1: 'Quels documents faut-il pour louer une voiture ?',
                faq_a1: "Vous aurez besoin d'un permis de conduire valide, d'un passeport ou d'une carte d'identité nationale, et d'une carte de crédit au nom du conducteur principal pour le dépôt de garantie. Certaines destinations peuvent exiger un permis de conduire international — nous vous le signalerons lors de la réservation.",
                faq_q2: "Y a-t-il un âge minimum pour louer une voiture ?",
                faq_a2: "L'âge minimum est généralement de 21 ans, bien que cela varie selon le fournisseur et le pays. Les conducteurs de moins de 25 ans peuvent être soumis à une majoration jeune conducteur. Certaines catégories de véhicules premium nécessitent un âge minimum de 25 ans.",
                faq_q3: 'Puis-je annuler ou modifier ma réservation ?',
                faq_a3: "Oui — la plupart des réservations incluent l'annulation gratuite jusqu'à 48 heures avant le départ. Les modifications peuvent être effectuées en contactant notre équipe d'assistance. Les conditions varient selon le tarif, consultez votre confirmation de réservation.",
                faq_q4: "Quelle assurance est incluse ?",
                faq_a4: "Toutes les locations incluent la Protection contre les Dommages par Collision (CDW) et la protection antivol en standard. Un excédent remboursable peut s'appliquer. Nous proposons également des options de protection complète contre la franchise.",
                faq_q5: 'Puis-je ajouter un conducteur supplémentaire ?',
                faq_a5: "Oui, des conducteurs supplémentaires peuvent être ajoutés au comptoir de location moyennant une petite redevance journalière. Ils doivent être présents au moment du départ avec leur permis de conduire et leur passeport. Certains fournisseurs incluent un conducteur supplémentaire gratuit.",
