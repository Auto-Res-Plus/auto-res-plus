---
interface Props {
    title?: string;
}
const { title = 'Holiday Car Rentals | Auto Reservation Plus' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
        :root {
            --brand-blue: #2BA6CB;
            --brand-green: #99CC00;
            --brand-orange: #ff6600;
            --dark-text: #333;
            --light-bg: #f4f4f4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'Helvetica Neue', Arial, sans-serif; background: var(--light-bg); line-height: 1.5; overflow-x: hidden; }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; width: 100%; }

        header { background: white; border-bottom: 1px solid #eee; padding-block: 0.5rem; }
        .top-flex { display: flex; justify-content: space-between; align-items: center; }
        .logo-area { line-height: 0; padding: 10px 0; }
        .logo-area img { max-width: 260px; }
        .phone { font-weight: bold; color: var(--brand-blue); white-space: nowrap; }

        .nav-flex { display: flex; list-style: none; margin: 0; padding: 0; flex: 1; }
        .nav-flex li a { display: block; padding: 0 20px; color: var(--brand-blue); text-decoration: none; font-weight: bold; font-size: 14px; line-height: 60px; transition: color 0.2s ease; }
        .nav-flex li a:hover { color: var(--brand-orange); }

        /* --- HAMBURGER & OFF-CANVAS --- */
        .nav-toggle {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
            margin-left: auto;
        }
        .nav-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            background: var(--brand-blue);
            border-radius: 2px;
            transition: transform 0.3s ease, opacity 0.3s ease;
            transform-origin: center;
        }
        .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
        .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 900;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .nav-overlay.is-open { opacity: 1; pointer-events: auto; }

        .off-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 280px;
            height: 100%;
            background: white;
            z-index: 1000;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            box-shadow: 4px 0 20px rgba(0,0,0,0.15);
            display: flex;
            flex-direction: column;
        }
        .off-canvas.is-open { transform: translateX(0); }

        .off-canvas-header {
            padding: 16px 20px;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .off-canvas-header img { max-width: 160px; }
        .off-canvas-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #999;
            line-height: 1;
            padding: 4px;
        }
        .off-canvas-close:hover { color: var(--brand-orange); }

        .off-canvas-nav { list-style: none; margin: 0; padding: 12px 0; }
        .off-canvas-nav li a {
            display: block;
            padding: 14px 24px;
            color: var(--dark-text);
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            border-left: 3px solid transparent;
            transition: color 0.2s ease, border-color 0.2s ease;
        }
        .off-canvas-nav li a:hover {
            color: var(--brand-orange);
            border-left-color: var(--brand-orange);
        }

        .off-canvas-phone {
            margin-top: auto;
            padding: 20px 24px;
            border-top: 1px solid #eee;
            font-weight: bold;
            color: var(--brand-blue);
            font-size: 14px;
        }

        @media (max-width: 900px) {
            .nav-flex { display: none; }
            .phone { display: none; }
            .nav-toggle { display: flex; }
            .logo-area img { max-width: 200px; }
        }

        footer { text-align: center; padding: 40px; color: #999; font-size: 13px; background: white; }
    </style>
</head>
<body>

    <!-- Off-canvas overlay -->
    <div class="nav-overlay" id="nav-overlay"></div>

    <!-- Off-canvas drawer -->
    <div class="off-canvas" id="off-canvas" aria-hidden="true">
        <div class="off-canvas-header">
            <img src="/images/logo.png" alt="Auto Reservation Plus logo">
            <button class="off-canvas-close" id="off-canvas-close" aria-label="Close menu">&times;</button>
        </div>
        <ul class="off-canvas-nav">
            <li><a href="/">Home</a></li>
            <li><a href="#">Manage Booking</a></li>
            <li><a href="#">Contact Us</a></li>
        </ul>
        <div class="off-canvas-phone">Tel: +44 (0)7377 753990</div>
    </div>

    <header>
        <div class="container top-flex">
            <div class="logo-area"><a href="/"><img src="/images/logo.png" alt="Auto Reservation Plus logo"></a></div>
            <nav>
                <ul class="nav-flex">
                    <li><a href="/">Home</a></li>
                    <li><a href="#">Manage Booking</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </nav>
            <div class="phone">Tel: +44 (0)7377 753990</div>
            <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-controls="off-canvas">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main>
        <slot />
    </main>

    <footer>
        &copy; 2026 - Auto Reservation Plus Limited
    </footer>

    <script is:inline>
        (function() {
            var toggle = document.getElementById('nav-toggle');
            var offCanvas = document.getElementById('off-canvas');
            var overlay = document.getElementById('nav-overlay');
            var closeBtn = document.getElementById('off-canvas-close');

            function openMenu() {
                toggle.classList.add('is-open');
                offCanvas.classList.add('is-open');
                overlay.classList.add('is-open');
                offCanvas.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }
            function closeMenu() {
                toggle.classList.remove('is-open');
                offCanvas.classList.remove('is-open');
                overlay.classList.remove('is-open');
                offCanvas.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            toggle.addEventListener('click', openMenu);
            closeBtn.addEventListener('click', closeMenu);
            overlay.addEventListener('click', closeMenu);
            document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMenu(); });
        })();
    </script>
</body>
</html>
