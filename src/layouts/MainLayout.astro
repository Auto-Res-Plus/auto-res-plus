                faq_a5: "Sì, i conducenti aggiuntivi possono essere aggiunti al banco noleggio per una piccola tariffa giornaliera. Devono essere presenti al ritiro con la loro patente di guida e passaporto. Alcuni fornitori includono un conducente aggiuntivo gratuito.",
                faq_q6: "Cosa succede se restituisco l'auto in ritardo?",
                faq_a6: "I fornitori di solito concedono un periodo di grazia di 30–60 minuti. Oltre a ciò, potrebbe essere applicato un addebito di un giorno aggiuntivo. Se sai che farai tardi, contatta direttamente il banco noleggio o chiama la nostra linea di assistenza 24/7.",
                whatsapp_cta: 'Contact Us'
            }
        };

        window.ARP.getLang = function() {
            return localStorage.getItem('arp_lang') || 'en';
        };
        window.ARP.getCurrency = function() {
            return localStorage.getItem('arp_currency') || 'GBP';
        };

        window.ARP.applyTranslations = function() {
            var lang     = window.ARP.getLang();
            var currency = window.ARP.getCurrency();
            var t = window.ARP.translations[lang] || window.ARP.translations.en;
            var p = window.ARP.prices[currency]   || window.ARP.prices.GBP;

            document.querySelectorAll('[data-i18n]').forEach(function(el) {
                var key = el.getAttribute('data-i18n');
                if (t[key] !== undefined) el.textContent = t[key];
            });

            document.querySelectorAll('[data-i18n-price]').forEach(function(el) {
                var city = el.getAttribute('data-i18n-price');
                if (p[city] && t.price_template) {
                    el.textContent = t.price_template.replace('{0}', p[city]);
                }
            });
        };
