---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout>
    <style is:global>
        /* --- THE HERO GRID --- */
        .hero-grid-wrapper {
            width: 100%;
            min-height: 600px;
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)),
                        url('/images/hero-bg.webp');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 40px;
            padding: 40px 0;
            align-items: center;
        }
        .hero-left-engine { align-self: center; }
        .hero-right {
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding-top: 24px;
            align-self: start;
        }

        .hero-headline { opacity: 0; transition: opacity 0.4s ease; }
        .hero-checklist .check-list li { opacity: 0; transition: opacity 0.4s ease; }
        .hero-headline h1 { color: white; font-size: 3.2rem; margin: 0; line-height: 1.1; font-weight: 800; text-shadow: 0 2px 10px rgba(0,0,0,0.3); }

        .check-list { list-style: none; padding: 0; margin: 0; }
        .check-list li { color: white; font-size: 1.25rem; margin-bottom: 10px; display: flex; align-items: center; font-weight: 500; }
        .check-list li::before {
            content: '✓'; display: inline-block; width: 22px; height: 22px; background: var(--brand-green);
            color: white; border-radius: 50%; text-align: center; line-height: 22px; margin-right: 12px; font-weight: bold; font-size: 12px;
        }

        /* --- THE SEARCH BOX --- */
        .engine-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            padding: 25px;
            width: 100%;
            max-width: 420px;
            margin-right: auto;
            position: relative;
            min-height: 414px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .engine-card.ct-ready {
            opacity: 1;
        }

        [ct-app], .ct-step-1-container, .ct-search-container {
            background: transparent !important;
            margin: 0 !important;
            padding: 0 !important;
            height: auto !important;
        }

        .ct-btn-p { background: var(--brand-orange) !important; }
        .ct-btn-p:hover { background: #FF7E29 !important; }

        /* --- LOGO TICKER --- */
        .logo-ticker-section {
            background: #fff;
            border-top: 1px solid #e8e8e8;
            padding-block: 3rem;
        }
        .ticker-track {
            overflow: hidden;
            width: 100%;
            position: relative;
        }
        .ticker-track::before,
        .ticker-track::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 12%;
            z-index: 1;
            pointer-events: none;
        }
        .ticker-track::before {
            left: 0;
            background: linear-gradient(to right, #fff, transparent);
        }
        .ticker-track::after {
            right: 0;
            background: linear-gradient(to left, #fff, transparent);
        }
        .ticker-inner {
            display: flex;
            align-items: center;
            width: max-content;
            will-change: transform;
        }
        .ticker-inner img {
            height: 30px;
            width: auto;
            object-fit: contain;
            flex-shrink: 0;
            padding-right: 76px;
            opacity: 0.7;
            transition: opacity 0.2s;
        }
        .ticker-inner img:hover {
            opacity: 1;
        }
        /* --- POPULAR LOCATIONS --- */
        .locations-section {
            background: white;
            padding-block: 2rem 6rem;
        }
        .locations-section h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--dark-text);
            margin: 0 0 1.75rem;
        }
        .locations-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(2, 240px);
            gap: 20px;
        }
        .location-card {
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .location-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 36px rgba(0,0,0,0.25);
        }
        .location-card-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            transition: transform 0.4s ease;
        }
        .location-card:hover .location-card-bg {
            transform: scale(1.05);
        }
        /* City SVG images */
        .loc-paris .location-card-bg {
            background-image: url('/images/locations/paris.webp');
        }
        .loc-berlin .location-card-bg {
            background-image: url('/images/locations/berlin.webp');
        }
        .loc-madrid .location-card-bg {
            background-image: url('/images/locations/madrid.webp');
        }
        .loc-rome .location-card-bg {
            background-image: url('/images/locations/rome.webp');
        }
        .loc-london .location-card-bg {
            background-image: url('/images/locations/london.webp');
        }
        .loc-lisbon .location-card-bg {
            background-image: url('/images/locations/lisbon.webp');
        }
        /* Overlay: gradient darkening at bottom for text legibility */
        .location-card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to bottom,
                rgba(0,0,0,0.45) 0%,
                rgba(0,0,0,0.2) 40%,
                rgba(0,0,0,0.6) 100%
            );
            transition: opacity 0.4s ease;
        }
        .location-card:hover .location-card-overlay {
            opacity: 0.2;
        }
        .location-card-content {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 16px 18px;
        }
        .location-card-name {
            display: inline-block;
            color: #fff;
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            text-shadow: 0 1px 3px rgba(0,0,0,0.3);
            margin-bottom: 4px;
            padding: 4px 12px;
            background: rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(12px) saturate(1.4);
            -webkit-backdrop-filter: blur(12px) saturate(1.4);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.35);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15), inset 0 1px 0 rgba(255,255,255,0.25);
        }
        .location-card-price {
            display: none;
        }

        /* --- FAQ --- */
        .faq-section {
            background:
                linear-gradient(rgba(244, 244, 244, 0.88), rgba(244, 244, 244, 0.88)),
                url('/images/hero-bg-2.webp') center / cover no-repeat;
            padding-block: 6rem;
        }
        .faq-section h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--dark-text);
            margin: 0 0 1.75rem;
        }
        .faq-layout {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 60px;
            align-items: stretch;
        }
        .faq-list {
            display: flex;
            flex-direction: column;
            gap: 0;
            align-self: start;
        }
        .faq-image {
            border-radius: 12px;
            overflow: hidden;
        }
        .faq-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .faq-item {
            background: rgba(255,255,255,0.5);
            backdrop-filter: blur(4px);
            border-radius: 10px;
            padding: 0 20px;
            margin-bottom: 10px;
        }
        .faq-item:last-child {
            margin-bottom: 0;
        }
        .faq-question {
            width: 100%;
            background: none;
            border: none;
            padding: 18px 0;
            text-align: left;
            font-size: 1rem;
            font-weight: 700;
            color: var(--dark-text);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }
        .faq-question:hover { color: var(--brand-blue); }
        .faq-icon {
            flex-shrink: 0;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--brand-blue);
            color: white;
            font-size: 1.1rem;
            line-height: 22px;
            text-align: center;
            transition: transform 0.3s ease, background 0.2s;
        }
        .faq-item.is-open .faq-icon {
            transform: rotate(45deg);
            background: var(--brand-orange);
        }
        .faq-answer {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.35s ease;
        }
        .faq-item.is-open .faq-answer {
            grid-template-rows: 1fr;
        }
        .faq-answer-inner {
            overflow: hidden;
        }
        .faq-answer-inner p {
            margin: 0 0 18px;
            color: #555;
            font-size: 0.95rem;
            line-height: 1.65;
        }

        @media (max-width: 900px) {
            .faq-layout {
                grid-template-columns: 1fr;
            }
            .faq-image { display: none; }
        }

        @media (max-width: 992px) {
            .locations-grid {
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: none;
            }
            .location-card { aspect-ratio: 16 / 9; }
        }
        @media (max-width: 560px) {
            .locations-section h2,
            .faq-section h2 { font-size: 1.7rem; }
            .locations-section { padding-block: 2rem 4rem; }
            .faq-section { padding-block: 4rem; }
            .locations-grid {
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: none;
                gap: 12px;
            }
            .location-card { aspect-ratio: 16 / 9; border-radius: 8px; }
            .location-card-name {
                background: none;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                border: none;
                box-shadow: none;
                padding: 0;
                border-radius: 0;
            }
        }

        @media (max-width: 992px) {
            .hero-grid-wrapper { min-height: 0; }
            .hero-grid {
                display: flex;
                flex-direction: column;
                padding: 30px 0;
                gap: 20px;
            }
            .hero-right { padding-top: 0; gap: 16px; }
            .hero-headline { width: 100%; text-align: center; }
            .hero-headline h1 { font-size: 2.2rem; }
            .engine-card { max-width: 100%; margin: 10px auto; padding: 15px 15px 1rem; min-height: 0; opacity: 1 !important; transition: none !important; }
            [ct-app], .ct-step-1-container, .ct-search-container { min-height: 0 !important; padding-bottom: 0 !important; }
            [ct-app] svg:not(.ctc-icon), [ct-app] img:not([class*="ctc-icon"]) { display: none !important; }
            .hero-checklist { text-align: center; }
            .check-list { display: inline-block; text-align: left; }
            .check-list li { justify-content: flex-start; }
        }

        @media (max-width: 767px) {
            /* Strip the bg image from the wrapper — it now lives on hero-right */
            .hero-grid-wrapper {
                background: white;
            }
            .hero-grid {
                padding: 0;
                gap: 0;
            }
            /* Hero image block: full-bleed, headline + checklist overlaid */
            .hero-right {
                order: -1;
                background:
                    linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
                    url('/images/hero-bg.webp') center / cover no-repeat;
                padding: 44px 20px 40px;
                /* break out of .container's 20px side padding */
                margin-left: -20px;
                margin-right: -20px;
                width: calc(100% + 40px);
                gap: 16px;
            }
            /* Left-align headline and checklist so they share the same left edge */
            .hero-headline { text-align: left; }
            .hero-headline h1 { font-size: 2rem; }
            .hero-checklist { text-align: left; }
            .check-list { display: block; width: 100%; }
            .check-list li { font-size: 1.0925rem; }
            /* Engine card sits below on a plain white surface */
            .hero-left-engine {
                background: white;
                padding: 0;
                width: 100%;
                min-height: 230px;
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .engine-card {
                box-shadow: none;
                margin-top: 0;
                margin-left: -20px;
                margin-right: -20px;
                width: calc(100% + 40px);
                max-width: none;
                border-radius: 0;
                padding: 0 20px 20px;
            }
            /* Hide CT decorative images/illustrations — they inflate card height on mobile */
            [ct-app] img, [ct-app] svg:not(.ctc-icon) { display: none !important; }
            .ct-usps__main { display: none !important; }
            .ct-container-search-cars { min-height: 0 !important; padding-bottom: 2rem !important; }
            [ct-app], .ct-step-1-container, .ct-search-container {
                min-height: 0 !important;
                height: auto !important;
                padding-bottom: 0 !important;
            }
        }
    </style>

    <section class="hero-grid-wrapper">
        <div class="container">
            <div class="hero-grid">
                <div class="hero-left-engine">
                    <div class="engine-card">
                        <div ct-app id="ct-mount-point"></div>
                    </div>
                </div>
                <div class="hero-right">
                    <div class="hero-headline">
                        <h1 data-i18n="hero_headline">Holiday Car Rentals</h1>
                    </div>
                    <div class="hero-checklist">
                        <ul class="check-list">
                            <li data-i18n="check_1">Free Cancellation</li>
                            <li data-i18n="check_2">No Hidden Charges</li>
                            <li data-i18n="check_3">800+ Suppliers Worldwide</li>
                            <li data-i18n="check_4">24/7 Customer Support</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- LOGO TICKER -->
    <section class="logo-ticker-section">
        <div class="container">
            <div class="ticker-track">
                <div class="ticker-inner">
                    <img src="/images/rental-logos/blue-logos/alamo-blue.svg" alt="Alamo">
                    <img src="/images/rental-logos/blue-logos/avis-blue.svg" alt="Avis">
                    <img src="/images/rental-logos/blue-logos/budget-blue.svg" alt="Budget">
                    <img src="/images/rental-logos/blue-logos/enterprise-blue.svg" alt="Enterprise">
                    <img src="/images/rental-logos/blue-logos/europcar-blue.svg" alt="Europcar">
                    <img src="/images/rental-logos/blue-logos/goldcar-blue.svg" alt="Goldcar">
                    <img src="/images/rental-logos/blue-logos/hertz-blue.svg" alt="Hertz">
                    <img src="/images/rental-logos/blue-logos/national-blue.svg" alt="National">
                    <img src="/images/rental-logos/blue-logos/payless-blue.svg" alt="Payless">
                    <img src="/images/rental-logos/blue-logos/sixt-blue.svg" alt="Sixt">
                    <img src="/images/rental-logos/blue-logos/thrifty-blue.svg" alt="Thrifty">
                    <!-- duplicate set for seamless loop -->
                    <img src="/images/rental-logos/blue-logos/alamo-blue.svg" alt="Alamo">
                    <img src="/images/rental-logos/blue-logos/avis-blue.svg" alt="Avis">
                    <img src="/images/rental-logos/blue-logos/budget-blue.svg" alt="Budget">
                    <img src="/images/rental-logos/blue-logos/enterprise-blue.svg" alt="Enterprise">
                    <img src="/images/rental-logos/blue-logos/europcar-blue.svg" alt="Europcar">
                    <img src="/images/rental-logos/blue-logos/goldcar-blue.svg" alt="Goldcar">
                    <img src="/images/rental-logos/blue-logos/hertz-blue.svg" alt="Hertz">
                    <img src="/images/rental-logos/blue-logos/national-blue.svg" alt="National">
                    <img src="/images/rental-logos/blue-logos/payless-blue.svg" alt="Payless">
                    <img src="/images/rental-logos/blue-logos/sixt-blue.svg" alt="Sixt">
                    <img src="/images/rental-logos/blue-logos/thrifty-blue.svg" alt="Thrifty">
                </div>
            </div>
        </div>
    </section>

    <!-- POPULAR LOCATIONS -->
    <section class="locations-section">
        <div class="container">
            <h2 data-i18n="locations_heading">Popular Rental Locations</h2>
            <div class="locations-grid">

                <div class="location-card loc-paris">
                    <div class="location-card-bg"></div>
                    <div class="location-card-overlay"></div>
                    <div class="location-card-content">
                        <span class="location-card-name">Paris</span>
                        <span class="location-card-price" data-i18n-price="paris">from £35 per day</span>
                    </div>
                </div>

                <div class="location-card loc-berlin">
                    <div class="location-card-bg"></div>
                    <div class="location-card-overlay"></div>
                    <div class="location-card-content">
                        <span class="location-card-name">Berlin</span>
                        <span class="location-card-price" data-i18n-price="berlin">from £28 per day</span>
                    </div>
                </div>

                <div class="location-card loc-madrid">
                    <div class="location-card-bg"></div>
                    <div class="location-card-overlay"></div>
                    <div class="location-card-content">
                        <span class="location-card-name">Madrid</span>
                        <span class="location-card-price" data-i18n-price="madrid">from £22 per day</span>
                    </div>
                </div>

                <div class="location-card loc-rome">
                    <div class="location-card-bg"></div>
                    <div class="location-card-overlay"></div>
                    <div class="location-card-content">
                        <span class="location-card-name">Rome</span>
                        <span class="location-card-price" data-i18n-price="rome">from £30 per day</span>
                    </div>
                </div>

                <div class="location-card loc-london">
                    <div class="location-card-bg"></div>
                    <div class="location-card-overlay"></div>
                    <div class="location-card-content">
                        <span class="location-card-name">London</span>
                        <span class="location-card-price" data-i18n-price="london">from £45 per day</span>
                    </div>
                </div>

                <div class="location-card loc-lisbon">
                    <div class="location-card-bg"></div>
                    <div class="location-card-overlay"></div>
                    <div class="location-card-content">
                        <span class="location-card-name">Lisbon</span>
                        <span class="location-card-price" data-i18n-price="lisbon">from £19 per day</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
        <div class="container">
            <h2 data-i18n="faq_heading">Frequently Asked Questions</h2>
            <div class="faq-layout">

                <div class="faq-list">
                    <div class="faq-item">
                        <button class="faq-question">
                            <span data-i18n="faq_q1">What documents do I need to hire a car?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer"><div class="faq-answer-inner">
                            <p data-i18n="faq_a1">You'll need a valid full driving licence, a passport or national ID card, and a credit card in the main driver's name for the security deposit. Some destinations may require an International Driving Permit — we'll flag this during the booking process.</p>
                        </div></div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">
                            <span data-i18n="faq_q2">Is there a minimum age to rent a car?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer"><div class="faq-answer-inner">
                            <p data-i18n="faq_a2">The minimum age is typically 21, though this varies by supplier and country. Drivers under 25 may incur a young driver surcharge. Some premium or specialist vehicle categories require a minimum age of 25.</p>
                        </div></div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">
                            <span data-i18n="faq_q3">Can I cancel or modify my booking?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer"><div class="faq-answer-inner">
                            <p data-i18n="faq_a3">Yes — most bookings include free cancellation up to 48 hours before pick-up. Amendments can be made by contacting our support team. Terms vary by rate type, so check your booking confirmation for full details.</p>
                        </div></div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">
                            <span data-i18n="faq_q4">What insurance is included?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer"><div class="faq-answer-inner">
                            <p data-i18n="faq_a4">All rentals include Collision Damage Waiver (CDW) and Theft Protection as standard, reducing your liability in the event of an accident or theft. A refundable excess may still apply. We also offer full excess protection upgrades for complete peace of mind.</p>
                        </div></div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">
                            <span data-i18n="faq_q5">Can I add an additional driver?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer"><div class="faq-answer-inner">
                            <p data-i18n="faq_a5">Yes, additional drivers can be added at the rental desk for a small daily fee. They must be present at pick-up with their driving licence and passport. Some suppliers include one additional driver free of charge — this will be shown on your voucher if applicable.</p>
                        </div></div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">
                            <span data-i18n="faq_q6">What happens if I return the car late?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer"><div class="faq-answer-inner">
                            <p data-i18n="faq_a6">Suppliers typically allow a grace period of 30–60 minutes. Beyond that, an additional day's charge may be applied. If you know you'll be late, contact the rental desk directly or call our 24/7 support line as early as possible to avoid extra fees.</p>
                        </div></div>
                    </div>
                </div>

                <div class="faq-image">
                    <img src="/images/faq-1.webp" alt="family holiday with hire car">
                </div>

            </div>
        </div>
    </section>

    <script is:inline>
        var _lang     = window.ARP.getLang();
        var _currency = window.ARP.getCurrency();

        var CT = {
          ABE: {
            Settings: {
              clientID: '315556',
              type: window.innerWidth < 800 ? 'mobile' : 'desktop',
              locale: window.ARP.ctLocales[_lang] || 'en_GB',
              currency: _currency,
              step1: {
                deeplinkURL: window.location.origin + '/results',
                showAvailNewWindow: false
              }
            }
          }
        };

        window.ARP.applyTranslations();

        (function() {
          CT.ABE.Settings.version = '5.0';
          var cts = document.createElement('script');
          cts.type = 'text/javascript'; cts.async = true;
          cts.src = 'https://ajaxgeo.cartrawler.com/abe5.0/ct_loader.js?' + new Date().getTime();
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(cts, s);
        })();

        /* --- THE COLOR AND PADDING POLICE --- */
        const tidyUp = setInterval(() => {
            const btn = document.querySelector('.ct-btn-search');
            const ctContainer = document.querySelector('.ct-search-container');

            if (btn) {
                btn.style.setProperty('background-color', '#2BA6CB', 'important');
                btn.style.setProperty('background-image', 'none', 'important');

                if (ctContainer) {
                    ctContainer.style.setProperty('margin', '0', 'important');
                    ctContainer.style.setProperty('padding', '0', 'important');
                }

                clearInterval(tidyUp);
            }
        }, 300);


        /* --- LOGO TICKER --- */
        (function() {
            var inner = document.querySelector('.ticker-inner');
            if (!inner) return;
            var x = 0;
            var speed = 1; // px per frame (~60px/s at 60fps)
            function tick() {
                var halfWidth = inner.scrollWidth / 2;
                x -= speed;
                if (x <= -halfWidth) x += halfWidth;
                inner.style.transform = 'translateX(' + x + 'px)';
                requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        })();

        /* --- FAQ ACCORDION --- */
        document.querySelectorAll('.faq-question').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var item = btn.closest('.faq-item');
                var isOpen = item.classList.contains('is-open');
                document.querySelectorAll('.faq-item.is-open').forEach(function(el) {
                    el.classList.remove('is-open');
                });
                if (!isOpen) item.classList.add('is-open');
            });
        });

        // Fade the engine card in only once CT has injected its content,
        // then fade the headline/checklist in shortly after
        (function() {
            var isMobile = window.innerWidth <= 992;
            var card     = document.querySelector('.engine-card');
            var engine   = document.querySelector('.hero-left-engine');
            var headline = document.querySelector('.hero-headline');
            var items    = document.querySelectorAll('.hero-checklist .check-list li');
            var mount    = document.getElementById('ct-mount-point');
            if (!card || !mount) return;

            var revealed = false;
            var reveal = function() {
                if (revealed) return;
                revealed = true;
                if (isMobile) {
                    // On mobile, wait for CT to fully settle before revealing
                    setTimeout(function() {
                        if (engine) engine.style.opacity = '1';
                    }, 500);
                } else {
                    card.classList.add('ct-ready');
                }
                setTimeout(function() {
                    if (headline) headline.style.opacity = '1';
                }, isMobile ? 600 : 150);
                items.forEach(function(item, i) {
                    setTimeout(function() {
                        item.style.opacity = '1';
                    }, (isMobile ? 700 : 350) + i * 120);
                });
            };

            var observer = new MutationObserver(function(_mutations, obs) {
                if (mount.children.length > 0) {
                    obs.disconnect();
                    reveal();
                }
            });
            observer.observe(mount, { childList: true, subtree: true });

            // Fallback — show after 4s regardless, so nothing stays hidden
            setTimeout(function() { reveal(); }, 4000);
        })();
    </script>
</MainLayout>
