---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout>
    <style is:global>
        /* --- THE HERO GRID --- */
        .hero-grid-wrapper {
            width: 100%;
            min-height: 550px;
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)),
                        url('/images/hero-bg.webp'); /* Ensure your path is correct here */
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            grid-template-rows: auto auto;
            gap: 20px 40px;
            padding: 40px 0;
        }
        .hero-headline    { grid-column: 2; grid-row: 1; align-self: end; }
        .hero-left-engine { grid-column: 1; grid-row: 1 / 3; align-self: center; }
        .hero-checklist   { grid-column: 2; grid-row: 2; align-self: start; }

        .hero-headline h1 { color: white; font-size: 3.2rem; margin: 0; line-height: 1.1; font-weight: 800; text-shadow: 0 2px 10px rgba(0,0,0,0.3); }

        .check-list { list-style: none; padding: 0; margin: 0; }
        .check-list li { color: white; font-size: 1.15rem; margin-bottom: 10px; display: flex; align-items: center; font-weight: 500; }
        .check-list li::before {
            content: '✓'; display: inline-block; width: 22px; height: 22px; background: #2BA6CB; /* Updated to brand blue */
            color: white; border-radius: 50%; text-align: center; line-height: 22px; margin-right: 12px; font-weight: bold; font-size: 12px;
        }

        /* --- THE SEARCH BOX --- */
        .engine-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            padding: 25px;
            width: 100%;
            max-width: 420px;
            margin-right: auto;
            position: relative;
            overflow: hidden; /* Contains the engine if it tries to bleed out */
        }

        [ct-app], .ct-step-1-container, .ct-search-container {
            background: transparent !important;
            margin: 0 !important;
            padding: 0 !important;
            height: auto !important;
        }

        /* Keep your Orange Button working across Desktop AND Mobile */
        .ct-btn-p, button.ct-btn-search, [ct-app] .ct-btn-primary { 
            background: #ff6a00 !important; 
            border: none !important;
            background-image: none !important; /* Kills default gradients */
            color: white !important;
        }
        .ct-btn-p:hover { background: #FF7E29 !important; }

        /* --- HOLIDAY AUTOS MOBILE SIMPLIFICATION OVERRIDES --- */
        @media (max-width: 992px) {
            .hero-grid-wrapper { min-height: 0; }
            .hero-grid {
                display: flex;
                flex-direction: column;
                padding: 30px 0;
                gap: 20px;
            }
            .hero-headline { width: 100%; text-align: center; }
            .hero-headline h1 { font-size: 2.2rem; }
            .engine-card { max-width: 100%; margin: 10px auto; padding: 15px; }
            .hero-checklist { text-align: center; }
            .check-list { display: inline-block; text-align: left; }
            .check-list li { justify-content: flex-start; }

            /* 1. Kill the forced full-screen heights so the white card shrinks to fit */
            .ct-mwa-container, .ct-mwa-view, .ct-wrapper, .ct-app-container, .ct-mwa {
                height: auto !important;
                min-height: 0 !important;
                position: static !important;
            }

            /* 2. Hide CarTrawler Mobile Headers, Footers, and extra UI junk */
            .ct-mwa-header, .ct-header, .ct-mobile-header, .ct-nav-container, 
            .ct-footer, .ct-mwa-footer, .ct-logo-container {
                display: none !important;
            }

            /* 3. Strip internal grey backgrounds so it sits cleanly on your white card */
            .ct-mwa-content, .ct-mobile-step-1, .ct-search-form {
                background: transparent !important;
                padding: 0 !important;
                margin: 0 !important;
                box-shadow: none !important;
            }
        }
    </style>

    <section class="hero-grid-wrapper">
        <div class="container">
            <div class="hero-grid">
                <div class="hero-headline">
                    <h1>Holiday Car Rentals</h1>
                </div>
                <div class="hero-left-engine">
                    <div class="engine-card">
                        <div ct-app id="ct-mount-point"></div>
                    </div>
                </div>
                <div class="hero-checklist">
                    <ul class="check-list">
                        <li>Free Cancellation</li>
                        <li>No Hidden Charges</li>
                        <li>800+ Suppliers Worldwide</li>
                        <li>24/7 Customer Support</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        var CT = {
          ABE: {
            Settings: {
              clientID: '315556',
              // Restore Mobile detection for native touch UX
              type: window.innerWidth < 800 ? 'mobile' : 'desktop', 
              step1: {
                deeplinkURL: window.location.origin + '/results',
                showAvailNewWindow: false
              }
            }
          }
        };

        (function() {
          CT.ABE.Settings.version = '5.0';
          var cts = document.createElement('script');
          cts.type = 'text/javascript'; cts.async = true;
          cts.src = 'https://ajaxgeo.cartrawler.com/abe5.0/ct_loader.js?' + new Date().getTime();
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(cts, s);
        })();

        /* --- THE PADDING POLICE --- */
        const tidyUp = setInterval(() => {
            const ctContainer = document.querySelector('.ct-search-container') || document.querySelector('.ct-mwa-content');
            if (ctContainer) {
                ctContainer.style.setProperty('margin', '0', 'important');
                ctContainer.style.setProperty('padding', '0', 'important');
                clearInterval(tidyUp);
            }
        }, 300);
    </script>
</MainLayout>