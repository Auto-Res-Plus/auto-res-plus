---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Manage Booking | Auto Reservation Plus">
    <style is:global>
        .manage-wrapper {
            width: 100%;
            min-height: 80vh;
            background: var(--light-bg);
        }
        .manage-wrapper .container {
            padding-top: 30px;
            padding-bottom: 30px;
        }
        #ct-manage-mount {
            width: 100%;
        }
        [ct-app] {
            background: transparent !important;
        }
    </style>

    <section class="manage-wrapper">
        <div class="container">
            <div ct-app id="ct-manage-mount"></div>
        </div>
    </section>

    <script is:inline>
        var CT = {
          ABE: {
            Settings: {
              clientID: '315556',
              type: 'resManagement',
              logo: '/images/logo.png'
            }
          }
        };

        (function() {
          CT.ABE.Settings.version = '5.0';
          var cts = document.createElement('script');
          cts.type = 'text/javascript'; cts.async = true;
          cts.src = 'https://ajaxgeo.cartrawler.com/abe5.0/ct_loader.js?' + new Date().getTime();
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(cts, s);
        })();
    </script>
</MainLayout>
