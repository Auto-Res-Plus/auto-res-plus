---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Search Results | Auto Reservation Plus">
    <style is:global>
        .results-wrapper {
            width: 100%;
            min-height: 80vh;
            background: var(--light-bg);
        }
        .results-wrapper .container {
            padding-top: 30px;
            padding-bottom: 30px;
        }
        /* Let CT own the full width of its container */
        #ct-results-mount {
            width: 100%;
        }
        [ct-app] {
            background: transparent !important;
        }
    </style>

    <section class="results-wrapper">
        <div class="container">
            <div ct-app id="ct-results-mount"></div>
        </div>
    </section>

    <script is:inline>
        var _lang     = window.ARP.getLang();
        var _currency = localStorage.getItem('arp_currency') || ({'fr':'EUR','de':'EUR','es':'EUR','it':'EUR'}[_lang] || 'GBP');

        var CT = {
          ABE: {
            Settings: {
              clientID: '315556',
              type: window.innerWidth < 800 ? 'mobile' : 'desktop',
              locale: window.ARP.ctLocales[_lang] || 'en_GB',
              currency: _currency,
              logo: '/images/logo.png',
              events: {
                vehicles: function(status, data) {
                  if (status === 'success' && typeof gtag === 'function') {
                    gtag('event', 'ct_vehicles', {
                      event_category: 'CarTrawler',
                      results_count: data && data.vehiclesData && data.vehiclesData.length
                    });
                  }
                },
                vehicle: function(status, data) {
                  if (status === 'success' && typeof gtag === 'function') {
                    gtag('event', 'ct_vehicle_selected', {
                      event_category: 'CarTrawler',
                      vehicle_name: data && data.vehicleData && data.vehicleData.name,
                      value: data && data.vehicleData && data.vehicleData.price,
                      currency: _currency
                    });
                  }
                },
                details: function(status) {
                  if (status === 'start' && typeof gtag === 'function') {
                    gtag('event', 'ct_details', { event_category: 'CarTrawler' });
                  }
                },
                payment: function(status) {
                  if (status === 'start' && typeof gtag === 'function') {
                    gtag('event', 'ct_payment', { event_category: 'CarTrawler' });
                  }
                },
                confirmation: function(status, data) {
                  if (status === 'success' && typeof gtag === 'function') {
                    gtag('event', 'purchase', {
                      event_category: 'CarTrawler',
                      transaction_id: data && data.reservationData && data.reservationData.id,
                      value: data && data.vehicleData && data.vehicleData.price,
                      currency: _currency
                    });
                  }
                }
              }
            }
          }
        };

        (function() {
          CT.ABE.Settings.version = '5.0';
          var cts = document.createElement('script');
          cts.type = 'text/javascript'; cts.async = true;
          cts.src = 'https://ajaxgeo.cartrawler.com/abe5.0/ct_loader.js';
          var s = document.getElementsByTagName('script')[0];
          s.parentNode.insertBefore(cts, s);
        })();
    </script>
</MainLayout>
